{
  "uid": "petbreed-mlops",
  "title": "Pet Breed MLOps \u2014 API Monitoring",
  "tags": [
    "mlops",
    "pet-breed",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "description": "1 = API scrape healthy, 0 = down",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"pet-breed-api\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Successful predictions",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "petbreed_predictions_total{job=\"pet-breed-api\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "HTTP error rate (5m)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(petbreed_http_requests_total{job=\"pet-breed-api\",status=~\"4..|5..\"}[5m])) or vector(0)",
          "legendFormat": "{{endpoint}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Request rate by endpoint (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(petbreed_http_requests_total{job=\"pet-breed-api\"}[5m]))",
          "legendFormat": "{{endpoint}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "p95 prediction latency (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "description": "Histogram-based estimate; requires sufficient requests within 5m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(petbreed_http_request_duration_seconds_bucket{job=\"pet-breed-api\",endpoint=\"/predict\"}[5m])))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "HTTP requests by status (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(petbreed_http_requests_total{job=\"pet-breed-api\"}[5m]))",
          "legendFormat": "{{endpoint}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Average prediction latency (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(petbreed_http_request_duration_seconds_sum{job=\"pet-breed-api\",endpoint=\"/predict\"}[5m])) / sum(rate(petbreed_http_request_duration_seconds_count{job=\"pet-breed-api\",endpoint=\"/predict\"}[5m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Drift status (fresh batch only)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "petbreed_drift_detected and on(job,instance) (petbreed_drift_report_available == 1) and on(job,instance) ((time() - petbreed_drift_batch_timestamp_seconds) < 86400)",
          "legendFormat": "Drift detected",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "petbreed-prometheus"
          },
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No drift",
                  "color": "green"
                },
                "1": {
                  "text": "DRIFT DETECTED",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 9,
      "title": "Latest batch age (hours)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "(time() - petbreed_drift_batch_timestamp_seconds) / 3600",
          "legendFormat": "Batch age",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "petbreed-prometheus"
          },
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 12
              },
              {
                "color": "red",
                "value": 24
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 10,
      "title": "Report available",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "petbreed_drift_report_available",
          "legendFormat": "Report available",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "petbreed-prometheus"
          },
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "MISSING / INVALID",
                  "color": "red"
                },
                "1": {
                  "text": "AVAILABLE",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 11,
      "title": "Drift scores vs calibrated thresholds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "expr": "petbreed_drift_score and on(job,instance) (petbreed_drift_report_available == 1) and on(job,instance) ((time() - petbreed_drift_batch_timestamp_seconds) < 86400)",
          "legendFormat": "{{detector}} score",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "petbreed-prometheus"
          },
          "instant": false
        },
        {
          "expr": "petbreed_drift_threshold and on(job,instance) (petbreed_drift_report_available == 1) and on(job,instance) ((time() - petbreed_drift_batch_timestamp_seconds) < 86400)",
          "legendFormat": "{{detector}} threshold",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "petbreed-prometheus"
          },
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 12,
      "title": "Drift alerts by detector (fresh batch only)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "petbreed-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "petbreed_drift_alert and on(job,instance) (petbreed_drift_report_available == 1) and on(job,instance) ((time() - petbreed_drift_batch_timestamp_seconds) < 86400)",
          "legendFormat": "{{detector}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "petbreed-prometheus"
          },
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Normal",
                  "color": "green"
                },
                "1": {
                  "text": "Alert",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
